{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",

    "db:generate": "npx drizzle-kit generate --name",
    "db:migrate": "npx drizzle-kit migrate",
    "db:seed": "node supabase/scripts/seed.js",
    "db:studio": "npx drizzle-kit studio",

    "db:migrate:dev": "cross-env APP_ENV=dev npx drizzle-kit push",
    "db:migrate:prod": "cross-env APP_ENV=prod npx drizzle-kit push",

    "supabase:init": "npx supabase init",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:status": "npx supabase status"
  },
  "dependencies": {
