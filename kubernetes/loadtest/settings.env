# Settings of the load test. Change a value, then start the test again (kubernetes/loadtestguide.txt).

# How many virtual users of each kind use the site at the same time.
CUSTOMER_VUS=20
ADMIN_VUS=2

# Time to reach those numbers, time at full load, and time to wind down.
RAMP_UP=1m
DURATION=3m
RAMP_DOWN=30s

# Every pause between two actions is multiplied by this.
# 1 is a realistic user. 0.2 makes the pauses five times shorter, for a quick trial run.
THINK_TIME_SCALE=1
