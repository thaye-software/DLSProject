{
  "info": {
    "name": "Users",
    "description": "Users service, called directly (not through the gateway): the user comes in as X-User-Id / X-User-Email headers. Run them top to bottom; `Delete account` ends the user, so pick a new userId (and username) to run again.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3005"
    },
    {
      "key": "userId",
      "value": "2b6f0c1e-4d53-4a8e-9a39-1f0f6b3c7a11"
    },
    {
      "key": "userEmail",
      "value": "mette@example.com"
    },
    {
      "key": "username",
      "value": "mette_j"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Username available",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/username-available?username={{username}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "username-available"
          ],
          "query": [
            {
              "key": "username",
              "value": "{{username}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create profile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-user-id",
            "value": "{{userId}}"
          },
          {
            "key": "x-user-email",
            "value": "{{userEmail}}"
          },
          {
            "key": "content-type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201 (or 200 when it already existed)\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "pm.test(\"role is customer\", () => pm.expect(pm.response.json().role).to.eql(\"customer\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-user-id",
            "value": "{{userId}}"
          },
          {
            "key": "x-user-email",
            "value": "{{userEmail}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "x-user-id",
            "value": "{{userId}}"
          },
          {
            "key": "x-user-email",
            "value": "{{userEmail}}"
          },
          {
            "key": "content-type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Mette\",\n  \"last_name\": \"Jensen\",\n  \"phone\": \"+45 26 46 95 96\",\n  \"country_code\": \"DK\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Save billing address",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "x-user-id",
            "value": "{{userId}}"
          },
          {
            "key": "x-user-email",
            "value": "{{userEmail}}"
          },
          {
            "key": "content-type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/me/address",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me",
            "address"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"address_line_1\": \"Nørregade 12\",\n  \"city\": \"København K\",\n  \"zip_code\": \"1165\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"address saved\", () => pm.expect(pm.response.json().address.city).to.eql(\"København K\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Forget billing address",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "x-user-id",
            "value": "{{userId}}"
          },
          {
            "key": "x-user-email",
            "value": "{{userEmail}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/me/address",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me",
            "address"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete account",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "x-user-id",
            "value": "{{userId}}"
          },
          {
            "key": "x-user-email",
            "value": "{{userEmail}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Profile is gone",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-user-id",
            "value": "{{userId}}"
          },
          {
            "key": "x-user-email",
            "value": "{{userEmail}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
