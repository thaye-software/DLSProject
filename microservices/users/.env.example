PORT=3005

DATABASE_URL=postgresql://users:users@localhost:5435/users
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Signs/verifies service JWTs; GET /internal/users/{id} accepts tokens with iss=auth, aud=users. Same value as in auth/.env.
INTERNAL_JWT_SECRET=replace-with-at-least-32-random-characters

# The x-supabasewebhook-secret header the Supabase email-confirmed database webhook sends (32+ characters).
SUPABASE_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# supabase, or fake to run without a Supabase project (nothing in Supabase is touched; avatars get a made-up URL).
IDENTITY_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
# Service-role key: deletes Supabase users and writes to the avatars bucket. Never give it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key
AVATAR_BUCKET=avatars
