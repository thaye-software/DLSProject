{
  "info": {
    "name": "Messaging",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Open conversation",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "{{userId}}" },
          { "key": "X-User-Email", "value": "mette@example.com" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": \"{{productId}}\"\n}"
        },
        "url": "{{baseUrl}}/conversations"
      }
    },
    {
      "name": "List conversations",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-User-Id", "value": "{{userId}}" }
        ],
        "url": "{{baseUrl}}/conversations"
      }
    },
    {
      "name": "Send message",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "{{userId}}" },
          { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Is this watch still available?\"\n}"
        },
        "url": "{{baseUrl}}/conversations/{{conversationId}}/messages"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3004" },
    { "key": "userId", "value": "2b6f0c1e-4d53-4a8e-9a39-1f0f6b3c7a11" },
    { "key": "productId", "value": "8d1d4c2a-77a5-4a2f-b0f4-2f3d0e7b9c55" },
    { "key": "conversationId", "value": "3e4f5a6b-7c8d-4e9f-a0b1-c2d3e4f5a6b7" },
    { "key": "idempotencyKey", "value": "c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f" }
  ]
}
