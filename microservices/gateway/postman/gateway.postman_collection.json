{
  "info": {
    "name": "Gateway",
    "description": "API Gateway at {{baseUrl}}. Folder 1 needs no account. Folders 3-4 need Supabase logins from folder 2; credentials go in current values (or an environment), never in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Gateway (no login)",
      "description": "Gateway behaviour that needs no Supabase account: routing, auth rejection, header stripping, CORS.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown path → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/does-not-exist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "/internal is never routed → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/internal/orders/x/payment-details"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Encoded traversal → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/%2e%2e/internal/x"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Protected route, no token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Protected route, garbage token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not-a-jwt",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forged X-User-* headers, no token → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-User-Role",
                "value": "admin"
              },
              {
                "key": "X-User-Email",
                "value": "evil@example.com"
              }
            ],
            "url": "{{baseUrl}}/conversations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"forged identity headers do not authenticate\", () => pm.response.to.have.status(401));",
                  "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Optional auth, anonymous → product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is the requested product\", () => pm.expect(pm.response.json().product_id).to.eql(pm.collectionVariables.get(\"productId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Optional auth, invalid token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not-a-jwt",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"a bad token is rejected even where auth is optional\", () => pm.response.to.have.status(401));",
                  "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search, anonymous",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/search?q=rolex"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has items array\", () => pm.expect(pm.response.json().items).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Contact, invalid body → 422 from notif",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/contact",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"reaches notif without auth (422 = notif validation)\", () => pm.response.to.have.status(422));",
                  "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stripe webhook, no signature → passes through",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/webhooks/stripe",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"not blocked by gateway auth\", () => pm.expect(pm.response.code).to.not.eql(401));",
                  "pm.test(\"400 (bad signature) or 404 (Stripe not configured in payment)\", () => pm.expect(pm.response.code).to.be.oneOf([400, 404]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Users webhook → 503 (Users not built)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/webhooks/supabase/email-confirmed",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 503\", () => pm.response.to.have.status(503));",
                  "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "CORS preflight from frontend origin",
          "request": {
            "method": "OPTIONS",
            "url": "{{baseUrl}}/orders",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization,content-type"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.test(\"origin allowed\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(pm.collectionVariables.get(\"frontendOrigin\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "CORS from unknown origin → not allowed",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "header": [
              {
                "key": "Origin",
                "value": "https://evil.example"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"no Access-Control-Allow-Origin\", () => pm.expect(pm.response.headers.has(\"Access-Control-Allow-Origin\")).to.be.false);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Login (Supabase)",
      "description": "Fill supabaseUrl, supabaseAnonKey and the email/password variables (current value only, never commit them). The admin account needs app_metadata.role = \"admin\" (see setupguide.txt).",
      "item": [
        {
          "name": "Login as customer",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabaseAnonKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"customerToken\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabaseAnonKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"adminToken\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Customer (Bearer customerToken)",
      "description": "Run after 'Login as customer'. Create order stores orderId for the rest.",
      "item": [
        {
          "name": "List my orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"offer_token\": null,\n  \"billing_address\": {\n    \"first_name\": \"Mette\",\n    \"middle_name\": null,\n    \"last_name\": \"Jensen\",\n    \"address_line_1\": \"Nørregade 12\",\n    \"address_line_2\": null,\n    \"city\": \"København K\",\n    \"zip_code\": \"1165\",\n    \"state_province\": null,\n    \"country_code\": \"DK\"\n  },\n  \"delivery_address\": {\n    \"first_name\": \"Mette\",\n    \"middle_name\": null,\n    \"last_name\": \"Jensen\",\n    \"address_line_1\": \"Nørregade 12\",\n    \"address_line_2\": null,\n    \"city\": \"København K\",\n    \"zip_code\": \"1165\",\n    \"state_province\": null,\n    \"country_code\": \"DK\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"orderId\", pm.response.json().order_id);",
                  "pm.test(\"is RESERVED\", () => pm.expect(pm.response.json().status).to.eql(\"RESERVED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is my order\", () => pm.expect(pm.response.json().order_id).to.eql(pm.collectionVariables.get(\"orderId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forged X-User-Role: admin is stripped → rejected",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-User-Role",
                "value": "admin"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/orders/{{orderId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PROCESSING\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"customer cannot act as admin\", () => pm.expect(pm.response.code).to.be.oneOf([403, 404]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel order",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}/cancel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is CANCELLED\", () => pm.expect(pm.response.json().status).to.eql(\"CANCELLED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "List my conversations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/conversations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{customerToken}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "4. Admin (Bearer adminToken)",
      "description": "Run after 'Login as admin'.",
      "item": [
        {
          "name": "List all orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List all conversations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/conversations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:3100"
    },
    {
      "key": "productId",
      "value": "8d1d4c2a-77a5-4a2f-b0f4-2f3d0e7b9c55"
    },
    {
      "key": "supabaseUrl",
      "value": ""
    },
    {
      "key": "supabaseAnonKey",
      "value": ""
    },
    {
      "key": "customerEmail",
      "value": ""
    },
    {
      "key": "customerPassword",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    }
  ]
}
