PORT=8000

SUPABASE_URL=https://<project>.supabase.co
# Supabase project JWT secret (Settings > API > JWT Secret), at least 32 characters
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret

# Upstream services; leave unset to route nothing to that service
ORDERS_URL=http://localhost:3000
PAYMENT_URL=http://localhost:3001
CATALOG_URL=http://localhost:3002
SEARCH_URL=http://localhost:3003
MESSAGING_URL=http://localhost:3004
NOTIF_URL=http://localhost:3005
USERS_URL=http://localhost:3006

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3100,https://limitedwatches.dk

UPSTREAM_TIMEOUT_MS=10000
