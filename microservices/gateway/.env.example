PORT=8000

SUPABASE_URL=https://<project>.supabase.co
# OPTIONAL. Exact `iss` claim to accept; defaults to $SUPABASE_URL/auth/v1.
# Local Supabase with the gateway in Docker: tokens say 127.0.0.1 but the container must reach the host, so set
#   SUPABASE_URL=http://host.docker.internal:55421
#   SUPABASE_JWT_ISSUER=http://127.0.0.1:55421/auth/v1
# SUPABASE_JWT_ISSUER=
# OPTIONAL, leave unset. Only for a local Supabase that still signs with the legacy HS256 secret.
# Anyone who knows this value can mint admin tokens: never use a placeholder or a published value.
# SUPABASE_JWT_SECRET=

# Upstream services; leave unset to route nothing to that service
ORDERS_URL=http://localhost:3000
PAYMENT_URL=http://localhost:3006
CATALOG_URL=http://localhost:3002
SEARCH_URL=http://localhost:3003
MESSAGING_URL=http://localhost:3004
NOTIF_URL=http://localhost:3007
# Users service is not built yet; unset means 503
# USERS_URL=http://localhost:3008

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3100,https://limitedwatches.dk

UPSTREAM_TIMEOUT_MS=10000
