<mxfile host="Electron">
  <diagram id="notif-arch" name="Notif Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="frame" value="" style="rounded=1;absoluteArcSize=1;arcSize=110;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a7f87;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="1440" height="870" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Notif Architecture" style="text;html=1;fontSize=30;fontStyle=1;fontColor=#111111;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="35" width="380" height="50" as="geometry" />
        </mxCell>

        <!-- Services -->
        <mxCell id="frontend" value="&lt;b style=&quot;font-size:15px&quot;&gt;Web frontend&lt;/b&gt;&lt;br&gt;&lt;br&gt;Contact page" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="40" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="&lt;b style=&quot;font-size:15px&quot;&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;br&gt;Authentication and routing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="150" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="notif" value="&lt;b style=&quot;font-size:15px&quot;&gt;Notif / Email&lt;/b&gt;&lt;br&gt;&lt;br&gt;Order confirmations and contact messages&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stateless, no database&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="270" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="resend" value="&lt;b style=&quot;font-size:15px&quot;&gt;Resend&lt;/b&gt;&lt;br&gt;&lt;br&gt;Email provider&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Deduplicates on idempotency key (24 h)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="270" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="inbox" value="&lt;b style=&quot;font-size:15px&quot;&gt;Recipient inbox&lt;/b&gt;&lt;br&gt;&lt;br&gt;Customer or contact address" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="130" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="payment" value="&lt;b style=&quot;font-size:15px&quot;&gt;Payment&lt;/b&gt;&lt;br&gt;&lt;br&gt;Card payments&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stateless, no database&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="535" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="orders" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="orders_text" value="&lt;b style=&quot;font-size:15px&quot;&gt;Orders&lt;/b&gt;&lt;br&gt;&lt;br&gt;Order lifecycle&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Outbox and inbox&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="orders_db" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="282" y="282" width="40" height="44" as="geometry" />
        </mxCell>
        <mxCell id="orders_db_t" value="PostgreSQL" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#1f2430;" vertex="1" parent="1">
          <mxGeometry x="267" y="330" width="70" height="20" as="geometry" />
        </mxCell>

        <!-- RabbitMQ -->
        <mxCell id="rmq_header" value="&lt;font color=&quot;#f26722&quot;&gt;&lt;b&gt;Rabbit&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;MQ&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=48;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="380" y="470" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rmq_icon_a" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f26722;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="396" y="488" width="22" height="16" as="geometry" />
        </mxCell>
        <mxCell id="rmq_icon_b" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f26722;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="396" y="480" width="6" height="10" as="geometry" />
        </mxCell>
        <mxCell id="rmq_icon_c" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f26722;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="406" y="483" width="6" height="7" as="geometry" />
        </mxCell>
        <mxCell id="rmq_payment" value="&lt;b style=&quot;font-size:15px&quot;&gt;payment.events&lt;/b&gt;&lt;br&gt;&lt;br&gt;payment_complete&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Publisher: Payment · Queue: orders.payment.events&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=16;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="520" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rmq_order" value="&lt;b style=&quot;font-size:15px&quot;&gt;order.events&lt;/b&gt;&lt;br&gt;&lt;br&gt;order_confirmed&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Publisher: Orders · Queue: notif.order.events, DLQ after 5 retries&lt;br&gt;CloudEvent payloads defined in AsyncAPI&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=16;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="630" width="360" height="130" as="geometry" />
        </mxCell>

        <!-- Synchronous HTTP -->
        <mxCell id="s1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1f2430;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="frontend" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s1t" value="1. HTTP / REST" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="580" y="120" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1f2430;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="notif">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2t" value="2. HTTP / REST&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /contact, no JWT&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="580" y="229" width="140" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1f2430;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="notif" target="resend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3t" value="3, 8. HTTP" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="705" y="290" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s3u" value="send email" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="705" y="320" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1f2430;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="resend" target="inbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4t" value="9. deliver" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="950" y="225" width="90" height="20" as="geometry" />
        </mxCell>

        <!-- Asynchronous events -->
        <mxCell id="a1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;dashed=1;dashPattern=6 5;strokeColor=#4b5260;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="payment" target="rmq_payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1t" value="4. publish" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="745" y="551" width="90" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;dashed=1;dashPattern=6 5;strokeColor=#4b5260;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.714;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rmq_payment" target="orders">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="575" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a2t" value="5. consume" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="275" y="551" width="90" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;dashed=1;dashPattern=6 5;strokeColor=#4b5260;strokeWidth=1.5;exitX=0.214;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="orders" target="rmq_order">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="120" y="695" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a3t" value="6. publish&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;outbox relay&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="660" width="100" height="32" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;dashed=1;dashPattern=6 5;strokeColor=#4b5260;strokeWidth=1.5;exitX=0.528;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rmq_header" target="notif">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4t" value="7. consume&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;order_confirmed, ack after the email is sent&lt;br&gt;retries 1, 2, 4, 8, 16 s, then DLQ&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="582" y="385" width="230" height="50" as="geometry" />
        </mxCell>

        <!-- Steps -->
        <mxCell id="steps" value="&lt;b style=&quot;font-size:14px&quot;&gt;Steps&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Contact message (synchronous)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; The contact page posts to /contact through the gateway. No JWT is needed.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; The gateway forwards to Notif, which validates the body (422 if invalid).&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Notif sends the email through Resend and answers 202, or 502 if Resend fails.&lt;br&gt;&lt;br&gt;&lt;i&gt;Order confirmation (asynchronous)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; After a successful payment, Payment publishes payment_complete.&lt;br&gt;&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Orders consumes it and confirms the order (RESERVED → PENDING), writing order_confirmed to its outbox in the same transaction.&lt;br&gt;&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; The outbox relay publishes order_confirmed on order.events.&lt;br&gt;&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Notif consumes it from notif.order.events and acks only after the email is sent. A failing send is retried after 1, 2, 4, 8 and 16 s, then goes to notif.order.events.dlq.&lt;br&gt;&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Notif sends the confirmation through Resend with the CloudEvent id as idempotency key, so a redelivered event does not send a second email.&lt;br&gt;&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; Resend delivers the email to the recipient." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;align=left;verticalAlign=top;spacing=14;fontColor=#1f2430;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="40" width="310" height="720" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="lg1" value="" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#1f2430;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="70" y="815" as="sourcePoint" />
            <mxPoint x="125" y="815" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg1t" value="Synchronous HTTP" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="135" y="805" width="130" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="" style="endArrow=block;endFill=1;endSize=8;html=1;dashed=1;dashPattern=6 5;strokeColor=#4b5260;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="290" y="815" as="sourcePoint" />
            <mxPoint x="345" y="815" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg2t" value="Asynchronous event" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="355" y="805" width="150" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
