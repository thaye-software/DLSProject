        <mxCell id="legend-note" value="Each service and its datastore sit behind a compose profile, so START_CATALOG=false (and so on) switches them off. auth, payment and notif have no datastore. The API Gateway, Editorial and Auctions are not in this compose setup." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
