<mxfile host="Electron">
  <diagram id="payment-arch" name="Payment Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="frame" value="" style="rounded=1;absoluteArcSize=1;arcSize=110;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a7f87;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="1440" height="870" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Payment Architecture" style="text;html=1;fontSize=30;fontStyle=1;fontColor=#111111;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="35" width="380" height="50" as="geometry" />
        </mxCell>

        <!-- Services -->
        <mxCell id="frontend" value="&lt;b style=&quot;font-size:15px&quot;&gt;Web frontend&lt;/b&gt;&lt;br&gt;&lt;br&gt;Checkout and Stripe.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="40" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="&lt;b style=&quot;font-size:15px&quot;&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;br&gt;Authentication and routing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="150" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="payment" value="&lt;b style=&quot;font-size:15px&quot;&gt;Payment&lt;/b&gt;&lt;br&gt;&lt;br&gt;Card payments and refunds&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stateless, no database&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="270" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stripe" value="&lt;b style=&quot;font-size:15px&quot;&gt;Stripe&lt;/b&gt;&lt;br&gt;&lt;br&gt;Payment provider&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PaymentIntents, refunds, webhooks&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="270" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="orders" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="orders_text" value="&lt;b style=&quot;font-size:15px&quot;&gt;Orders&lt;/b&gt;&lt;br&gt;&lt;br&gt;Order lifecycle&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Outbox and inbox&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="orders_db" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="282" y="282" width="40" height="44" as="geometry" />
        </mxCell>
        <mxCell id="orders_db_t" value="PostgreSQL" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#1f2430;" vertex="1" parent="1">
          <mxGeometry x="267" y="330" width="70" height="20" as="geometry" />
        </mxCell>

        <!-- RabbitMQ -->
        <mxCell id="rmq_header" value="&lt;font color=&quot;#f26722&quot;&gt;&lt;b&gt;Rabbit&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;MQ&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=48;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="380" y="470" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rmq_icon_a" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f26722;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="396" y="488" width="22" height="16" as="geometry" />
        </mxCell>
        <mxCell id="rmq_icon_b" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f26722;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="396" y="480" width="6" height="10" as="geometry" />
        </mxCell>
        <mxCell id="rmq_icon_c" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f26722;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="406" y="483" width="6" height="7" as="geometry" />
        </mxCell>
        <mxCell id="rmq_payment" value="&lt;b style=&quot;font-size:15px&quot;&gt;payment.events&lt;/b&gt;&lt;br&gt;&lt;br&gt;payment_complete · payment_failed · payment_refunded&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Publisher: Payment · Queue: orders.payment.events&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=16;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="520" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rmq_order" value="&lt;b style=&quot;font-size:15px&quot;&gt;order.events&lt;/b&gt;&lt;br&gt;&lt;br&gt;order_cancelled · order_expired · refund_requested&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Publisher: Orders · Queue: payment.order.events, DLQ after 5 retries&lt;br&gt;CloudEvent payloads defined in AsyncAPI&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=16;fontColor=#1f2430;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="640" width="400" height="120" as="geometry" />
        </mxCell>

        <!-- Synchronous HTTP -->
        <mxCell id="s1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1f2430;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="frontend" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s1t" value="1, 9. HTTP / REST" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="580" y="120" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1f2430;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2t" value="2, 6. HTTP / REST" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="580" y="235" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1f2430;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.231;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="orders">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="125" y="185" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s3t" value="9. HTTP / REST&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;order status&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="150" width="120" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1f2430;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="payment" target="orders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4t" value="3. HTTP" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="355" y="290" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s4u" value="payment details" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="345" y="320" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1f2430;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="payment" target="stripe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5t" value="4, 11. HTTP" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="705" y="290" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s5u" value="create, cancel, refund" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="695" y="320" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1f2430;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="frontend" target="stripe">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1000" y="75" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s6t" value="5. Stripe.js confirm" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="850" y="52" width="140" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1f2430;strokeWidth=1.5;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stripe" target="gateway">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="880" y="185" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s7t" value="6. Webhook (HTTP)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stripe-Signature&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="700" y="150" width="140" height="32" as="geometry" />
        </mxCell>

        <!-- Asynchronous events -->
        <mxCell id="a1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;dashed=1;dashPattern=6 5;strokeColor=#4b5260;strokeWidth=1.5;exitX=0.333;exitY=1;exitDx=0;exitDy=0;entryX=0.375;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="payment" target="rmq_header">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1t" value="7. publish&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;after the webhook,&lt;br&gt;once the broker confirms&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="380" y="385" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;dashed=1;dashPattern=6 5;strokeColor=#4b5260;strokeWidth=1.5;exitX=0.575;exitY=0;exitDx=0;exitDy=0;entryX=0.667;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rmq_header" target="payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2t" value="11. consume&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;order_cancelled, order_expired: cancel&lt;br&gt;refund_requested: refund&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="620" y="385" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;dashed=1;dashPattern=6 5;strokeColor=#4b5260;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.714;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rmq_payment" target="orders">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="580" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a3t" value="8. consume" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="275" y="556" width="90" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;dashed=1;dashPattern=6 5;strokeColor=#4b5260;strokeWidth=1.5;exitX=0.214;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="orders" target="rmq_order">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="120" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a4t" value="10. publish" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="205" y="676" width="90" height="20" as="geometry" />
        </mxCell>

        <!-- Steps -->
        <mxCell id="steps" value="&lt;b style=&quot;font-size:14px&quot;&gt;Steps&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Checkout calls POST /payments via the gateway.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; The gateway verifies the Supabase JWT with Auth (forward-auth) and forwards the request with X-User-Id.&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Payment reads amount and status from Orders. 404 if not the user's order, 409 if not RESERVED.&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Payment creates the PaymentIntent (idempotency key = order id) and returns its client_secret.&lt;br&gt;&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; The browser confirms the card directly with Stripe.&lt;br&gt;&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Stripe sends the webhook through the gateway; Payment verifies the signature.&lt;br&gt;&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Payment publishes a CloudEvent (id = UUIDv5 of the Stripe event id). It answers Stripe 200 only after RabbitMQ confirms; otherwise 500 and Stripe retries.&lt;br&gt;&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Orders consumes, skips event ids it has seen (inbox) and updates the order.&lt;br&gt;&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; The success page reads the order status (RESERVED shows as processing).&lt;br&gt;&lt;br&gt;&lt;b&gt;10.&lt;/b&gt; On cancellation, expiry or a refund request, Orders publishes to order.events through its outbox.&lt;br&gt;&lt;br&gt;&lt;b&gt;11.&lt;/b&gt; Payment cancels the open PaymentIntent or refunds it (key = refund_request_id). Stripe's charge.refunded webhook becomes payment_refunded via steps 6 to 8." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6670;strokeWidth=1.5;align=left;verticalAlign=top;spacing=14;fontColor=#1f2430;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="40" width="310" height="720" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="lg1" value="" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#1f2430;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="70" y="815" as="sourcePoint" />
            <mxPoint x="125" y="815" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg1t" value="Synchronous HTTP" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="135" y="805" width="130" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="" style="endArrow=block;endFill=1;endSize=8;html=1;dashed=1;dashPattern=6 5;strokeColor=#4b5260;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="290" y="815" as="sourcePoint" />
            <mxPoint x="345" y="815" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg2t" value="Asynchronous event" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="355" y="805" width="150" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
