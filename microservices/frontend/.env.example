# API Gateway (server-side only)
GATEWAY_URL=http://localhost:8000

# Supabase (login + realtime chat)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# OPTIONAL, server-side only (runtime). Where the Next.js server reaches Supabase when that differs from the
# browser URL, e.g. local Supabase with the frontend in Docker: http://host.docker.internal:55421
SUPABASE_URL=

# Stripe.js (publishable key only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Public site URL (canonical URLs, sitemap, confirmation redirects)
NEXT_PUBLIC_BASE_URL=http://localhost:3100
