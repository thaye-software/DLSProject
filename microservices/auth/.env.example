PORT=3001

# supabase, or fake to run without a Supabase project: then "Bearer fake:<user id>" (or fake:<user id>:<email>)
# signs in as that user, unchecked. Never use fake where real clients can reach Auth. SUPABASE_URL is then not needed.
TOKEN_VERIFIER=supabase

# The Supabase project. Tokens must be issued by <SUPABASE_URL>/auth/v1; the signing keys are read from
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://your-project.supabase.co
# Only for projects still on the legacy shared JWT secret (HS256 tokens). Leave empty for asymmetric signing keys.
SUPABASE_JWT_SECRET=

# Role lookup: GET <USERS_URL>/internal/users/{id} with a service JWT (iss=auth, aud=users).
USERS_URL=http://localhost:3005
# Same value as INTERNAL_JWT_SECRET in users/.env.
INTERNAL_JWT_SECRET=replace-with-at-least-32-random-characters

# How long a role is cached; a role change or deleted account takes up to this long to apply.
ROLE_CACHE_TTL_MS=30000
