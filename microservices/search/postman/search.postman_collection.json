            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"is a page of results\", () => pm.expect(pm.response.json()).to.have.keys([\"items\", \"page\", \"page_size\", \"total\"]));",
              "pm.test(\"page and size echoed\", () => { const b = pm.response.json(); pm.expect(b.page).to.eql(2); pm.expect(b.page_size).to.eql(5); });"
            ]
