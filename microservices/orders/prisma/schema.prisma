// Orders database, as in docs/microservice-erd.drawio. Money is DKK in øre (bigint).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  // One of the nine OrderStatus values; enforced by orders_status_check in the migration.
  status            String        @db.VarChar(15)
  shippingPriceDkk  BigInt        @map("shipping_price_dkk")
  subTotalDkk       BigInt        @map("sub_total_dkk")
  totalPriceDkk     BigInt        @map("total_price_dkk")
  deliveryAddressId String?       @map("delivery_address_id") @db.Uuid
  billingAddressId  String?       @map("billing_address_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  customerEmail     String        @map("customer_email") @db.VarChar(255)
  expiresAt         DateTime?     @map("expires_at")
  // Null for orders created from auction_complete, which have no HTTP request.
  idempotencyKey    String?       @map("idempotency_key") @db.Uuid
  items             OrderItem[]
  deliveryAddress   OrderAddress? @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id])
  billingAddress    OrderAddress? @relation("BillingAddress", fields: [billingAddressId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  quantity     Int
  productName  String  @map("product_name") @db.VarChar(255)
  thumbnailUrl String? @map("thumbnail_url")
  unitPriceDkk BigInt  @map("unit_price_dkk")
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model OrderAddress {
  id             String  @id @default(uuid()) @db.Uuid
  firstName      String  @map("first_name") @db.VarChar(255)
  middleName     String? @map("middle_name") @db.VarChar(255)
  lastName       String  @map("last_name") @db.VarChar(255)
  addressLine1   String  @map("address_line_1") @db.VarChar(255)
  addressLine2   String? @map("address_line_2") @db.VarChar(255)
  city           String  @db.VarChar(255)
  zipCode        String  @map("zip_code") @db.VarChar(20)
  stateProvince  String? @map("state_province") @db.VarChar(255)
  // ISO 3166-1 alpha-2
  country        String  @db.VarChar(2)
  deliveryOrders Order[] @relation("DeliveryAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@map("order_addresses")
}

// Transactional outbox: written in the same transaction as the state change, published by the relay.
model OutboxEvent {
  id          String    @id @db.Uuid // the CloudEvent id
  type        String    @db.VarChar(64)
  payload     Json      @db.JsonB // the full CloudEvent
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox")
}

// Idempotent inbox: the CloudEvent ids already handled.
model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  type        String   @db.VarChar(64)
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}
